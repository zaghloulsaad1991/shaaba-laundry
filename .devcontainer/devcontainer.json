{
  "name": "Shaaba Laundry System v2",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "npm install",
  "postAttachCommand": "npm start",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Shaaba Laundry App",
      "onAutoForward": "openPreview",
      "visibility": "public"
    }
  }
}
